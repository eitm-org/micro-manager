<project name="FOVSymmetry" default="jar">
	<import file="../javapluginbuild.xml"/>
    <!-- Adds images to the jar -->
	<target name="copy-files" depends="mm.javabuild.copy-files"
		unless="mm.java.disable.build">
		<copy todir="${intdir}">
         <fileset dir="${rscdir}">
            <include name="**/*.png"/>
         </fileset>
		</copy>
	</target>

	<target name="unittest">
    <junit printsummary="yes" showoutput="true">
        <classpath>
            <pathelement location="./junit-4.8.2.jar"/>
            <pathelement location="./ant-junit4.jar"/>
        </classpath>

        <formatter type="plain" />

        <test name="com.mytest.unittest.SimpleTest" outfile="./testresult" />
    </junit>
    <fail message="test failed" if="test.failure" />
</target>


</project>
